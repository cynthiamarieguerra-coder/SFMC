SELECT 
    EmailAddress,
    COUNT(DISTINCT SubscriberKey) AS SubscriberKeyCount  
FROM 
    _Subscribers  
GROUP BY 
    EmailAddress  
HAVING 
    COUNT(DISTINCT SubscriberKey) > 1
    
