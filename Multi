--------------------------------------------------------------------------
Birthdate = Today or in 7 days + >= Year

SELECT
convert(date, Date_of_Birth__c) as Birthday

FROM ent.Lead_Salesforce
WHERE

DATEPART(day,Date_of_Birth__c) = DATEPART(day,DATEADD(day,7,GETDATE())) AND
DATEPART(month,Date_of_Birth__c) = DATEPART(month,DATEADD(day,7,GETDATE())) AND
DATEPART("year", Date_of_Birth__c) >= 1957
