Group Join


Select a.EmailAddress, a.contact_key_count
from (select e.EmailAddress, count(e.SubscriberKey) as contact_key_count
from ent._Subscribers e
join [Shlink Contacts and Leads] s on e.EmailAddress = s.EmailAddress
group by e.EmailAddress) a
where a.contact_key_count > 1
group by a.EmailAddress, a.contact_key_count
