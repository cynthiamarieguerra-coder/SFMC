Multiple condition
Select l._ContactKey as ContactKey, l.Id, l.Email, l.RecordTypeId, 
l.Status, l.CreatedDate, l.FirstName, l.LastName, l.Market_Code__c, l.Record_Type_Name__c, l.PostalCode, l.Date_of_Birth__c, l.Most_Recent_Campaign__c
from ent.Lead_Salesfrce l
join wnderman_campaign_list_matches w on w.CampaignId = l.Most_Recent_Campaign__c
where ConvertedContactID is null
and HasOptedOutofEmail = 'False'
and RecordTypeId = '01213000001CF9jAAG'
and Date_of_Birth__c is not null
