Left Outer Join

Select s.contactkey, s.RecordTypeId, s.Record_Type_Name__c, s.Email, s.Fets_Subscriber_id__c, s.LeadSrce, s.Market_Code__c, s.Date_of_Birth__c, s.FirstName, s.LastName, d.SUFFIX, d.PLN_R_BK, d.FIRST, d.LAST, d.MEM_DOB, d.LOB
from [SL Leads wDE] s
left outer join [DM_Member] d on d.SUB_ID = s.Fats_Subscriber_id__c and d.EmailAddress = s.Email and d.FIRST = s.FirstName and d.LAST = s.LastName
