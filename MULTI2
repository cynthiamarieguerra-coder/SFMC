Populate a DE


SELECT
MBR_ID,
EmailAddress,
'DP163' as CampaignName,
'CT' as Origin,
'Brker' as MKT_LOB
FROM
[DE]
WHERE
EmailAddress is not null AND
(MAPD_PDP = 'Y'OR
APD_PDP = 'Y' OR
Med_Sup = 'Y'
)


SELECT
PLN_MBR_BK,
EmailAddress,
'DAP162102' as CampaignName,
'CT' as Origin,
'Brokers' as MK_LOB
FROM
[DM_Procer]
WHERE
EmailAddress is not null AND
(Small_Bus = 'Y'
)
